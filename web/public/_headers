# Cache hashed assets forever with immutable flag
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static media/icons
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML entry points must revalidate to pick up new deploys immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
