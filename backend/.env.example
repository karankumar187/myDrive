# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://drive_admin:drive_password@localhost:27017/unified_drive?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Encryption
# IMPORTANT: Generate a 32-byte hex key (e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=dev_jwt_secret_key_drive_personal_cloud_min_32_chars_long
JWT_EXPIRES_IN=7d

# 1. Google App Authentication (User Login via Passport.js)
# Scope: openid, profile, email
GOOGLE_AUTH_CLIENT_ID=your_google_auth_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_auth_client_secret
GOOGLE_AUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# 2. Google Drive Storage Account Authorization (Storage Pooling)
# Scope: https://www.googleapis.com/auth/drive.file
GDRIVE_CLIENT_ID=your_gdrive_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret
GDRIVE_REDIRECT_URI=http://localhost:5000/api/v1/storage/connect/callback
